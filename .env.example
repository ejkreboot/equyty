# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser (RLS protects data).
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Imported exclusively from src/lib/server/*.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (AI categorization + Advice) ───────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5

# ─── Plaid ────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
# sandbox | production — selects which secret below is used
PLAID_ENV=sandbox
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
# Fallback if the environment-specific secret above is empty
PLAID_SECRET=
# Comma-separated Plaid products. Investments is optional (extra Plaid approval).
PLAID_PRODUCTS=transactions
PLAID_OPTIONAL_PRODUCTS=investments
# Public HTTPS URL Plaid posts webhooks to (e.g. https://your-app.vercel.app/api/plaid/webhook)
PLAID_WEBHOOK_URL=
# Required for OAuth banks in production; must be registered in the Plaid dashboard.
# e.g. https://your-app.vercel.app/plaid/oauth
PLAID_REDIRECT_URI=
# 32 random bytes, base64. Encrypts Plaid access tokens at rest.
#   openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
# Any long random string; Vercel sends it as a Bearer token to /api/cron/sync.
#   openssl rand -hex 32
CRON_SECRET=
